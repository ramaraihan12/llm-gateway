PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway
# Bearer token for /admin/*, at least 16 characters. Left empty on purpose so
# the gateway refuses to start until you set one, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
GATEWAY_CONFIG=gateway.yaml
LOG_LEVEL=info

OLLAMA_BASE_URL=http://localhost:11434
# Leave a key empty to switch that provider off. Chains then skip it.
# A key already set in your shell wins over this file, even over an empty
# value, so unset it there as well. The startup log lists enabled providers.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
