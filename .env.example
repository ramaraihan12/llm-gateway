PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_gateway
# Bearer token for /admin/*, at least 16 characters.
ADMIN_TOKEN=change-me-to-a-long-random-string
GATEWAY_CONFIG=gateway.yaml
LOG_LEVEL=info

OLLAMA_BASE_URL=http://localhost:11434
# Leave a key empty to switch that provider off. Chains then skip it.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
